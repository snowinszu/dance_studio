{
  // 单元测试专用编译配置：把 src/ 和 tests/unit/ 一起编到 dist-test/，
  // 再由 scripts/run-unit-tests.mjs 用 node:test 跑 dist-test/tests/unit/*.test.js。
  // 与主 tsconfig 分开，是因为要放宽 rootDir 以纳入 tests/ 目录。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-test",
    "noEmit": false,
    "sourceMap": false,
    // reports.charts.js 是渲染层文件、不进主 tsc 构建；这里编进 dist-test/
    // 好让 tests/unit/reports-charts.test.ts 直接把它当模块导入做单测。
    // 不开 checkJs：只转译、不对这份手写 JS 做类型报错。
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts", "reports.charts.js"]
}
